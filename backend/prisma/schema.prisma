datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  Int           @id @default(autoincrement())
  email               String        @unique
  password            String
  name                String
  gender              String?
  birthDate           DateTime?
  height              Float?        // in cm
  currentWeight       Float?        // in kg
  targetWeight        Float?        // in kg
  medicalConditions   String?       // text detailing injuries/ailments
  labResults          String?       // blood tests/health metrics
  workoutLocation     String?       // "HOME" or "GYM"
  equipment           String?       // comma-separated list of available equipment
  fitnessGoal         String?       // e.g. "HYPERTROPHY", "LOSE_WEIGHT"
  fitnessLevel        String?       // e.g. "beginner", "intermediate", "advanced"
  age                 Int?          // user's age
  daysPerWeek         Int?          // days per week of workout
  workoutReminder     Boolean       @default(false)
  reminderTime        String?       // e.g. "08:00"
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  onboardingCompleted Boolean       @default(false)
  resetOtp            String?
  resetOtpExpiry      DateTime?
  googleId            String?
  isGoogleLinked      Boolean       @default(false)
  googleEmail         String?
  workoutPlans        WorkoutPlan[]
  weightLogs          WeightLog[]
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float
  date      DateTime @default(now())
  notes     String?  // user comments on how they feel that day
}

model WorkoutPlan {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String        // e.g. "Week 1-4: Foundation Phase"
  durationWeeks Int           @default(4)
  startDate     DateTime
  active        Boolean       @default(true)
  weeklyTips    String?       // overall instructions for the week
  isManual      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  dayWorkouts   DayWorkout[]

  @@index([userId, active])
}

model DayWorkout {
  id         Int         @id @default(autoincrement())
  planId     Int
  plan       WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayIndex   Int         // 1 to 7 (Day 1, Day 2 etc)
  title      String      // e.g. "Push Day - Iron Chest & Shoulders"
  focusArea  String      // e.g. "Chest, Shoulders, Triceps"
  dayTips    String?     // dynamic tips for warm-up, stretching
  isRestDay  Boolean     @default(false)
  exercises  Exercise[]

  @@index([planId, dayIndex])
}

model Exercise {
  id                    Int           @id @default(autoincrement())
  dayWorkoutId          Int?
  dayWorkout            DayWorkout?   @relation(fields: [dayWorkoutId], references: [id], onDelete: Cascade)
  name                  String
  name_en               String?
  name_ar               String?
  description_en        String?
  description_ar        String?
  instructions_en       String?
  instructions_ar       String?
  muscle_en             String?
  muscle_ar             String?
  targetMuscle          String?       // e.g. "Chest", "Quads"
  equipment_en          String?
  equipment_ar          String?
  level                 String?
  category              String?       // "IRON", "YOGA", "PILATES", "HIIT", "CARDIO", "CALISTHENICS"
  rating                Float?        @default(0.0)
  source                String?
  sanskrit_name         String?
  imageUrl              String?
  image_url             String?
  secondary_muscles_en  String?
  secondary_muscles_ar  String?
  common_mistakes_en    String?
  common_mistakes_ar    String?
  gif_url               String?
  youtube_url           String?
  videoUrl              String?
  anatomy_image_url     String?
  sets                  Int?          @default(3)
  reps                  String?       @default("10-12") // Can be "10-12", "Max", "30s", etc.
  weight                String?       // e.g. "15kg", "Bodyweight"
  exerciseTips          String?       // Form advice
  order                 Int           @default(0)
  progressLogs          ProgressLog[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([muscle_en])
  @@index([muscle_ar])
  @@index([category])
  @@index([name_en])
  @@index([name_ar])
  @@index([dayWorkoutId])
}

model ExerciseLibrary {
  id                    Int      @id @default(autoincrement())
  name                  String?
  name_en               String?
  name_ar               String?
  description           String?
  description_en        String?
  description_ar        String?
  instructions_en       String?
  instructions_ar       String?
  muscle_en             String?
  muscle_ar             String?
  targetMuscle          String?
  equipment_en          String?
  equipment_ar          String?
  level                 String?
  category              String?
  rating                Float?   @default(0.0)
  source                String?
  sanskrit_name         String?
  imageUrl              String?
  image_url             String?
  secondary_muscles_en  String?
  secondary_muscles_ar  String?
  common_mistakes_en    String?
  common_mistakes_ar    String?
  gif_url               String?
  youtube_url           String?
  videoUrl              String?
  anatomy_image_url     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([muscle_en])
  @@index([muscle_ar])
  @@index([category])
  @@index([name_en])
  @@index([name_ar])
}

model ProgressLog {
  id            Int      @id @default(autoincrement())
  exerciseId    Int
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  completedSets Int
  repsCompleted String   // e.g. "12,11,10"
  weightUsed    String?  // e.g. "15kg, 15kg, 15kg"
  notes         String?  // How the user felt during the exercise
}

model CheckIn {
  id                Int      @id @default(autoincrement())
  userId            Int
  date              DateTime @default(now())
  workoutFeel       String   // EASY, NORMAL, HARD
  sessionsCompleted String   // YES, MOSTLY, NO
  painNotes         String?
  aiRecommendation  String?
  applied           Boolean  @default(false)
}

model TempSync {
  code      String   @id
  payload   String   // JSON string of full sync payload
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("temp_sync")
}
